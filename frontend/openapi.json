          },
          "other_drivers_effect_pct": {
            "type": "number",
            "title": "Other Drivers Effect Pct"
          },
          "adjustment": {
            "$ref": "#/components/schemas/AdjustmentOut"
          },
          "inputs": {
            "$ref": "#/components/schemas/InputsOut"
          },
          "context": {
            "$ref": "#/components/schemas/ContextOut"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Model estimate of the Transfermarkt crowd valuation, not a transfer fee."
          }
        },
        "type": "object",
        "required": [
          "player",
          "as_of_date",
          "model_version",
          "data_version",
          "estimate_eur",
          "interval",
          "intervals",
          "market_value",
          "league_median_eur",
          "baseline_eur",
          "drivers",
          "other_drivers_effect_pct",
          "adjustment",
          "inputs",
          "context"
        ],
        "title": "ValuationOut"
      },
      "WhatIfIn": {
