# fair-football-fee API: code and serving dependencies only. The model is data: mount artifacts/ at
# /app/artifacts (read-only). The active version comes from model_versions, so a newly registered
# model is picked up within a minute without rebuilding this image.
FROM python:3.12-slim-trixie

# XGBoost's Linux wheel links against the GCC OpenMP runtime, which the slim image doesn't ship
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /app

# Dependencies first, in their own layer: it is rebuilt only when pyproject.toml or constraints.txt
# change. Only [project.dependencies] (what serving imports), at the versions in constraints.txt;
# on Linux that means xgboost-cpu, the CPU-only build of the same XGBoost release.
COPY pyproject.toml constraints.txt ./
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']))" \
        > /tmp/requirements.txt \
    && pip install -c constraints.txt -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY alembic.ini ./
COPY migrations ./migrations
COPY src ./src

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER app

# WEB_CONCURRENCY = uvicorn worker processes. FORWARDED_ALLOW_IPS = the proxies allowed to set
# X-Forwarded-For (uvicorn's default, 127.0.0.1, trusts none outside the container).
ENV WEB_CONCURRENCY=2
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/v1/health', timeout=2)"]
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
