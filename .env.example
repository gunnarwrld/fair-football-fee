# PostgreSQL Serving Database (SQLAlchemy + Psycopg 3)
# Host port 5433 avoids clashing with a natively installed Postgres on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://fff_user:fff_pass@localhost:5433/fair_football_fee

# Redis Cache-Aside Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_LOCK_TIMEOUT_SECONDS=5
# Redis is optional: short timeouts, then the API skips it for this many seconds after an error
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_RETRY_AFTER_SECONDS=30
METADATA_REFRESH_SECONDS=60

# Storage Paths
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# API Configuration
API_V1_PREFIX=/v1
RATE_LIMIT_PER_MINUTE=60
# Load shedding, per worker: requests in flight beyond this get an immediate 503 "busy"
MAX_CONCURRENT_REQUESTS=16
# Seconds to wait for a free database connection before a 503 "busy"
DB_POOL_TIMEOUT_SECONDS=2
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Containers (make up): uvicorn worker processes, and the reverse proxies allowed to set
# X-Forwarded-For (uvicorn reads it; without a proxy in front, leave the default)
API_WORKERS=2
FORWARDED_ALLOW_IPS=127.0.0.1
# The API address the browser uses, baked into the UI image at build time
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
