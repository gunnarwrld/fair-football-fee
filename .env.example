# PostgreSQL Serving Database (SQLAlchemy + Psycopg 3)
DATABASE_URL=postgresql+psycopg://fff_user:fff_pass@localhost:5432/fair_football_fee

# Redis Cache-Aside Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_LOCK_TIMEOUT_SECONDS=5
METADATA_REFRESH_SECONDS=60

# Storage Paths
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# API Configuration
API_V1_PREFIX=/v1
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
